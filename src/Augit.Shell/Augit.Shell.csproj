<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 发布产物使用产品名 Augit，与安装器、审计脚本和用户可见的进程名保持一致。 -->
    <AssemblyName>Augit</AssemblyName>
    <RootNamespace>Augit.Shell</RootNamespace>
    <Version>1.0.0-rc.1</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2"
                      ExcludeAssets="all"
                      GeneratePathProperty="true"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Augit.Core\Augit.Core.csproj" />
    <ProjectReference Include="..\Augit.Infrastructure\Augit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core"
               HintPath="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3650.58\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll"
               Private="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3650.58\runtimes\win-x64\native\WebView2Loader.dll"
             Link="native\WebView2Loader.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3650.58\LICENSE.txt"
             Link="licenses\Microsoft.Web.WebView2-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3650.58\NOTICE.txt"
             Link="licenses\Microsoft.Web.WebView2-NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    界面本体是 web/ 下的 HTML、CSS 和 JavaScript，缺少这些文件产品无法启动。
    Build 与 Publish 是两条独立路径：只挂 Build 时 `dotnet publish -o <独立目录>`
    会跳过复制，产物就是一个没有界面的空壳，因此这里两条路径都必须覆盖。

    这里是“完整镜像”而不是增量复制：先 RemoveDir 清掉本次生成的目标 web，再全量复制。
    原因：SkipUnchangedFiles 只比较时间戳和长度，源文件删除后目标会残留旧文件，
    同长度同时间戳的内容变化也不会刷新，两种情形都会让审计证据来自旧界面。
    路径先归一化为绝对路径，OutDir/PublishDir 按 MSBuildProjectDirectory 解析
    （publish -o 传入的相对目录因此仍然落在项目目录下，而不是当前工作目录）。
    删除前拒绝自身与祖先/子目录目标，避免删掉源目录本身。
  -->
  <Target Name="CopyWebAssets" AfterTargets="Build">
    <PropertyGroup>
      <!-- 统一绝对路径与尾部分隔符，防护比较遵循 Windows 大小写不敏感规则。 -->
      <_WebAssetsSourceBase>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'web'))</_WebAssetsSourceBase>
      <_WebAssetsTarget>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'web'))</_WebAssetsTarget>
      <_WebAssetsSourceCompare>$(_WebAssetsSourceBase.ToUpperInvariant())</_WebAssetsSourceCompare>
      <_WebAssetsTargetCompare>$(_WebAssetsTarget.ToUpperInvariant())</_WebAssetsTargetCompare>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WebAssetsSourceBase)')" Text="CopyWebAssets 源目录不存在：$(_WebAssetsSourceBase)。" />
    <Error Condition="$(_WebAssetsTargetCompare.StartsWith('$(_WebAssetsSourceCompare)')) Or $(_WebAssetsSourceCompare.StartsWith('$(_WebAssetsTargetCompare)'))" Text="CopyWebAssets 拒绝删除目标：源与目标目录不得相同或相互包含 ($(_WebAssetsTarget))。" />
    <ItemGroup>
      <_WebAsset Include="$(_WebAssetsSourceBase)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_WebAssetsTarget)" />
    <Copy SourceFiles="@(_WebAsset)"
          DestinationFiles="@(_WebAsset->'$(_WebAssetsTarget)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
  </Target>

  <Target Name="CopyWebAssetsToPublishDirectory" AfterTargets="Publish">
    <PropertyGroup>
      <_WebAssetsPublishSourceBase>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'web'))</_WebAssetsPublishSourceBase>
      <_WebAssetsPublishTarget>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', 'web'))</_WebAssetsPublishTarget>
      <_WebAssetsPublishSourceCompare>$(_WebAssetsPublishSourceBase.ToUpperInvariant())</_WebAssetsPublishSourceCompare>
      <_WebAssetsPublishTargetCompare>$(_WebAssetsPublishTarget.ToUpperInvariant())</_WebAssetsPublishTargetCompare>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WebAssetsPublishSourceBase)')" Text="CopyWebAssetsToPublishDirectory 源目录不存在：$(_WebAssetsPublishSourceBase)。" />
    <Error Condition="$(_WebAssetsPublishTargetCompare.StartsWith('$(_WebAssetsPublishSourceCompare)')) Or $(_WebAssetsPublishSourceCompare.StartsWith('$(_WebAssetsPublishTargetCompare)'))" Text="CopyWebAssetsToPublishDirectory 拒绝删除目标：源与目标目录不得相同或相互包含 ($(_WebAssetsPublishTarget))。" />
    <ItemGroup>
      <_WebAssetForPublish Include="$(_WebAssetsPublishSourceBase)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_WebAssetsPublishTarget)" />
    <Copy SourceFiles="@(_WebAssetForPublish)"
          DestinationFiles="@(_WebAssetForPublish->'$(_WebAssetsPublishTarget)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
  </Target>

  <!-- 全仓搜索依赖随包分发的 ripgrep；缺省时从 PATH 查找，因此这里必须一并部署。 -->
  <ItemGroup>
    <Content Include="..\..\tools\ripgrep\win-x64\ripgrep-15.2.0-x86_64-pc-windows-msvc\rg.exe"
             Link="tools\rg.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\ripgrep\win-x64\ripgrep-15.2.0-x86_64-pc-windows-msvc\LICENSE-MIT"
             Link="licenses\ripgrep-LICENSE-MIT.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\ripgrep\win-x64\ripgrep-15.2.0-x86_64-pc-windows-msvc\UNLICENSE"
             Link="licenses\ripgrep-UNLICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- 内置终端界面由 web/vendor/xterm 提供，随包分发必须同时附带两个组件的许可证。 -->
    <Content Include="..\..\web\vendor\jetbrains-mono\OFL.txt"
             Link="licenses\JetBrainsMono-OFL.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\xterm-6.0.0\LICENSE"
             Link="licenses\xterm-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\addon-fit-0.11.0\LICENSE"
             Link="licenses\xterm-addon-fit-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
