<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Augit</AssemblyName>
    <Version>0.1.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Web.WebView2"
                      ExcludeAssets="all"
                      GeneratePathProperty="true"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Augit.Core\Augit.Core.csproj" />
    <ProjectReference Include="..\Augit.Infrastructure\Augit.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core"
               HintPath="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3650.58\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll"
               Private="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tools\ripgrep\win-x64\ripgrep-15.2.0-x86_64-pc-windows-msvc\rg.exe"
             Link="tools\rg.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\ripgrep\win-x64\ripgrep-15.2.0-x86_64-pc-windows-msvc\LICENSE-MIT"
             Link="licenses\ripgrep-LICENSE-MIT.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\ripgrep\win-x64\ripgrep-15.2.0-x86_64-pc-windows-msvc\UNLICENSE"
             Link="licenses\ripgrep-UNLICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md"
             Link="README.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\scintilla\win-x64\scintilla-5.6.6\Scintilla.dll"
             Link="native\Scintilla.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\scintilla\win-x64\scintilla-5.6.6\LICENSE.txt"
             Link="licenses\Scintilla-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\Markdig-LICENSE.txt"
             Link="licenses\Markdig-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\InnoSetup-LICENSE.txt"
             Link="licenses\InnoSetup-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3650.58\LICENSE.txt"
             Link="licenses\Microsoft.Web.WebView2-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3650.58\NOTICE.txt"
             Link="licenses\Microsoft.Web.WebView2-NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3650.58\runtimes\win-x64\native\WebView2Loader.dll"
             Link="native\WebView2Loader.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\terminal\index.html"
             Link="terminal\index.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\terminal\terminal.js"
             Link="terminal\terminal.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\xterm-6.0.0\lib\xterm.js"
             Link="terminal\xterm.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\xterm-6.0.0\css\xterm.css"
             Link="terminal\xterm.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\addon-fit-0.11.0\lib\addon-fit.js"
             Link="terminal\addon-fit.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\xterm-6.0.0\LICENSE"
             Link="licenses\xterm-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tools\xterm\addon-fit-0.11.0\LICENSE"
             Link="licenses\xterm-addon-fit-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
